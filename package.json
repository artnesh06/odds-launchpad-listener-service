{
  "name": "nft-listener-service",
  "version": "1.0.0",
  "description": "Activity listener service for NFT Launchpad - monitors blockchain events 24/7",
  "main": "src/index.ts",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc",
    "postinstall": "prisma generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify-env": "tsx src/scripts/verify-env.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed-chains": "tsx scripts/seed-chains-and-factories.ts",
    "scan-history": "tsx src/scripts/scan-historical-deployments.ts",
    "test-events": "tsx src/scripts/test-real-events.ts",
    "deploy-test": "tsx src/scripts/deploy-and-test.ts",
    "deploy": "tsx src/scripts/deploy-launchpad.ts",
    "check-deploy": "tsx src/scripts/check-deployment.ts",
    "get-address": "tsx src/scripts/get-deployed-address.ts",
    "register": "tsx src/scripts/register-launchpad.ts",
    "clean-duplicates": "tsx scripts/clean-duplicate-activities.ts",
    "verify-phases": "tsx scripts/verify-phase-indices.ts",
    "repair-phases": "tsx scripts/repair-phase-indices.ts"
  },
  "keywords": [
    "blockchain",
    "ethereum",
    "nft",
    "listener",
    "web3"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@types/bull": "^3.15.9",
    "@types/busboy": "^1.5.4",
    "@types/form-data": "^2.5.2",
    "@types/ioredis": "^4.28.10",
    "@types/pg": "^8.16.0",
    "@types/socket.io": "^3.0.2",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "axios": "^1.13.5",
    "bull": "^4.16.5",
    "busboy": "^1.6.0",
    "dotenv": "^16.6.1",
    "ethers": "^6.16.0",
    "form-data": "^4.0.5",
    "ioredis": "^5.9.3",
    "pg": "^8.18.0",
    "pinata": "^2.5.5",
    "pinata-web3": "^0.5.4",
    "socket.io": "^4.8.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "tsx": "^4.21.0",
    "viem": "^2.46.2",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.11",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.0.18",
    "fast-check": "^4.5.3",
    "prisma": "^5.22.0",
    "socket.io-client": "^4.8.3",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "overrides": {
    "minimatch": "^11.0.9",
    "glob": "^14.0.6",
    "uuid": "^11.1.1"
  }
}
