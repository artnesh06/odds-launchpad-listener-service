# Database Configuration
DATABASE_URL="postgresql://user:password@host:5432/database?schema=public"

# Environment
NODE_ENV="production"
PORT="3001"

# =====================================================
# Chains & RPC (required)
# =====================================================
# Chains to listen to (comma-separated). MegaETH mainnet = 4326
LISTENER_CHAIN_IDS="4326"
# RPC endpoints in priority order (comma-separated). The listener fails over
# between them automatically and benches endpoints that lag behind.
# Never put RPC URLs with API keys in source code - only here.
RPC_URLS_4326="https://mainnet.megaeth.com/rpc,https://rpc-megaeth-mainnet.globalstake.io,https://megaeth.rpc.sentio.xyz,https://megaeth.drpc.org"
# First block to index on a fresh database (factory deployment block).
# Leave empty to start from the current block. After the first run the
# position is stored in the database and this value is ignored.
START_BLOCK_4326="7672067"

# Polling tuning (optional)
POLL_INTERVAL_MS="2000"
POLL_CONFIRMATIONS="3"
POLL_MAX_BLOCK_RANGE="50000"
RPC_TIMEOUT_MS="15000"
RPC_MAX_LAG_BLOCKS="30"
# Restart the process if a poller makes no progress for this long (ms)
WATCHDOG_STALE_MS="600000"

# =====================================================
# Security (required)
# =====================================================
# Admin key for /api/admin/*, sync/refresh/restart endpoints (long random string).
# The launchpad app sends it server-side as LISTENER_ADMIN_API_KEY.
ADMIN_API_KEY=""
# Browser origins allowed to call the API and Socket.IO (comma-separated)
CORS_ORIGINS="https://launchpad.artnesh.com"
WEBSOCKET_CORS_ORIGIN="https://launchpad.artnesh.com"

# IPFS uploads (Pinata)
PINATA_JWT=""
PINATA_GATEWAY_URL=""

# Testing Configuration (Optional)
# Used for integration testing with real blockchain
TEST_PRIVATE_KEY="your_private_key_here"
# Or use mnemonic
TEST_MNEMONIC="your twelve word mnemonic phrase here"

# =====================================================
# WebSocket, Redis, and other configurations
# can also be moved to database if needed
# =====================================================

# =====================================================
# Blockchain Event Listener Configuration
# =====================================================
# This section configures the hybrid event monitoring system that combines
# WebSocket-based real-time listening for mint events on featured launchpads
# with traditional polling for all other events.
#
# For complete documentation, see: docs/ENVIRONMENT_VARIABLES.md

# Enable WebSocket listening for real-time mint events on featured launchpads
# Set to "true" to enable WebSocket connections for launchpads with isFeatured=true
# Set to "false" to use polling for all events (default)
WEBSOCKET_ENABLED="false"

# WebSocket provider URL for blockchain event listening
# REQUIRED when WEBSOCKET_ENABLED="true"
# Must use wss:// protocol for secure connections
# Example: wss://eth-mainnet.g.alchemy.com/v2/YOUR_API_KEY
WEBSOCKET_PROVIDER_URL=""

# WebSocket Reconnection Configuration
# Maximum number of reconnection attempts before alerting (default: 10)
WEBSOCKET_MAX_RECONNECT_ATTEMPTS="10"

# Base delay for exponential backoff in milliseconds (default: 1000)
# Reconnection delays: 1s, 2s, 4s, 8s, 16s, 30s (capped at max delay)
WEBSOCKET_RECONNECT_BASE_DELAY="1000"

# Maximum delay between reconnection attempts in milliseconds (default: 30000)
WEBSOCKET_RECONNECT_MAX_DELAY="30000"

# Polling Configuration
# Polling interval for non-WebSocket events in milliseconds (default: 5000)
# Applies to all non-mint events and mint events on non-featured launchpads
POLLING_INTERVAL="5000"

# Batch size for polling queries (default: 100, range: 1-1000)
POLLING_BATCH_SIZE="100"

# =====================================================
# WebSocket Server Configuration
# =====================================================
# Configuration for the WebSocket server that handles client connections
# (separate from blockchain WebSocket connections above)

# Port for WebSocket server (separate from health check port)
# Socket.IO is served on PORT by default; set WEBSOCKET_SEPARATE_PORT=true to use WEBSOCKET_PORT
WEBSOCKET_PORT="3002"

# CORS origin whitelist (comma-separated)

# Connection limits
WEBSOCKET_MAX_CONNECTIONS="1000"

# Message size limit in bytes (1MB default)
WEBSOCKET_MESSAGE_SIZE_LIMIT="1048576"

# Ping/pong configuration for connection health (in milliseconds)
WEBSOCKET_PING_INTERVAL="30000"
WEBSOCKET_PING_TIMEOUT="5000"

# Reconnection attempts
WEBSOCKET_RECONNECT_ATTEMPTS="5"

# Authentication (set to true to enable JWT authentication)
WEBSOCKET_AUTH_ENABLED="false"

# Monitoring and metrics
WEBSOCKET_METRICS_ENABLED="true"
WEBSOCKET_LOG_LEVEL="info"

# Rate Limiting Configuration
# Enable/disable rate limiting (enabled by default)
WEBSOCKET_RATE_LIMIT_ENABLED="true"

# Connection rate limiting (per IP address)
# Time window in milliseconds (default: 60000 = 1 minute)
WEBSOCKET_CONNECTION_RATE_WINDOW_MS="60000"
# Maximum connections per IP in the time window (default: 10)
WEBSOCKET_MAX_CONNECTIONS_PER_WINDOW="10"

# Message rate limiting (per WebSocket connection)
# Time window in milliseconds (default: 60000 = 1 minute)
WEBSOCKET_MESSAGE_RATE_WINDOW_MS="60000"
# Maximum messages per connection in the time window (default: 100)
WEBSOCKET_MAX_MESSAGES_PER_WINDOW="100"

# Backpressure mechanism
# Threshold as a percentage (0.0-1.0) of limit to trigger backpressure (default: 0.8 = 80%)
WEBSOCKET_BACKPRESSURE_THRESHOLD="0.8"
# Delay in milliseconds to apply when backpressure is active (default: 100)
WEBSOCKET_BACKPRESSURE_DELAY_MS="100"

# Redis Configuration (for Queue System)
# Redis host
REDIS_HOST="localhost"
# Redis port
REDIS_PORT="6379"
# Redis password (optional)
REDIS_PASSWORD=""
# Redis database number (default: 0)
REDIS_DB="0"

# Alchemy API Configuration (for NFT Metadata)
# Alchemy API key for NFT metadata fetching
ALCHEMY_API_KEY="your_alchemy_api_key_here"

# =====================================================
# Ponder Configuration (v0.16.1)
# =====================================================
# All Ponder configurations (RPC URLs, Factory addresses, Launchpads)
# are now stored in the database.
# 
# Database Tables:
#   - chains: RPC URLs, chain IDs, network names
#   - launchpad_factories: Master Factory addresses per chain
#   - launchpads: Individual launchpad contracts
# 
# To update Ponder configuration:
#   1. Update database (INSERT/UPDATE chains, factories, or launchpads)
#   2. Config auto-regenerates (if watcher is running)
#   3. Restart Ponder: npm run ponder:start
# 
# Manual regeneration (if watcher not running):
#   npm run ponder:generate-config
# 
# See documentation:
#   - docs/PONDER_DYNAMIC_FACTORY_CONFIG.md
#   - docs/PONDER_AUTO_CONFIG_REGENERATION.md
# 
# MIGRATION NOTES (v0.16.1):
#   - Package renamed: @ponder/core → ponder
#   - Config structure: networks → chains, chainId → id, transport → rpc
#   - Context API: context.network → context.chain
#   - Addresses: All addresses are now lowercase
#   - Performance: Improved live indexing (50+ ops/sec)
# =====================================================

# Ponder Sync Configuration
# Set to 'true' to enable historical sync on startup (default: true)
PONDER_ENABLE_HISTORICAL_SYNC="true"

# Ponder Log Level (debug, info, warn, error)
PONDER_LOG_LEVEL="info"
